{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@ben/adapters": ["./packages/adapters/src/index.ts"],
      "@ben/adapters/*": ["./packages/adapters/src/*"],
      "@ben/domain-base": ["./packages/domain/base/src/index.ts"],
      "@ben/domain-base/*": ["./packages/domain/base/src/*"],
      "@ben/modules-utils": ["./packages/modules/utils/src/index.ts"],
      "@ben/modules-utils/*": ["./packages/modules/utils/src/*"],
      "@ben/modules-env": ["./packages/modules/env/src/index.ts"],
      "@ben/modules-env/*": ["./packages/modules/env/src/*"],
      "@ben/modules-tests": ["./packages/modules/tests/src/index.ts"],
      "@ben/modules-tests/*": ["./packages/modules/tests/src/*"]
    }
  }
}
