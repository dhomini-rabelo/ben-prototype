{
  "name": "@ben/mobile-ben",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "pnpm icons && expo start --web --port 8081",
    "start": "pnpm icons && expo start",
    "android": "pnpm icons && expo run:android",
    "ios": "expo run:ios",
    "android:prebuild": "expo prebuild --platform android --no-install --clean",
    "apk": "pnpm icons && pnpm android:prebuild && cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.195",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@tanstack/react-query": "^5.100.14",
    "ai": "^6.0.193",
    "axios": "^1.16.1",
    "expo": "~54.0.0",
    "expo-audio": "~1.1.1",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.0",
    "expo-crypto": "~15.0.0",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.0",
    "expo-haptics": "~15.0.0",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "firebase": "^12.13.0",
    "jotai": "^2.20.0",
    "lucide-react-native": "^0.544.0",
    "nativewind": "^4.2.1",
    "phosphor-react-native": "^3.0.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.76.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "~5.9.2"
  }
}
