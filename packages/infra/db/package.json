{
  "name": "@ben/infra-db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "postinstall": "prisma generate --no-hints",
    "generate": "prisma generate --no-hints",
    "typecheck": "prisma generate --no-hints && tsc -p tsconfig.json --noEmit",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "smoke:sqlite": "tsx scripts/smoke-sqlite.ts"
  },
  "dependencies": {
    "@ben/domain-base": "workspace:*",
    "@ben/domain-notification": "workspace:*",
    "@ben/domain-chat": "workspace:*",
    "@ben/domain-task": "workspace:*",
    "@ben/domain-topic": "workspace:*",
    "@ben/domain-user": "workspace:*",
    "@ben/modules-utils": "workspace:*",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.15.29",
    "prisma": "7.10.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}
